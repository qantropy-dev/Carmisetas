# ---------------------------------------------------------------------------
# Supabase. En local: `supabase start` los imprime. En produccion: panel del
# proyecto -> Settings -> API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Salta RLS: nunca con prefijo NEXT_PUBLIC_, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numero de WhatsApp del cierre de pedido: indicativo de pais + numero, sin "+".
# Ej. Colombia: 573001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Recorte automatico (opcional)
# ---------------------------------------------------------------------------
# Por defecto el modelo se descarga del CDN de @imgly. Con `npm run imgly:mirror`
# se copia a public/imgly y se sirve desde nuestro dominio: mas rapido y sin
# depender de un tercero. Si lo espejas, descomenta:
# NEXT_PUBLIC_IMGLY_PUBLIC_PATH=/imgly/
