{
  "name": "carmisetas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed:assets": "tsx scripts/build-seed-assets.ts",
    "seed:sql": "tsx scripts/build-seed-sql.ts",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "seed": "npm run seed:assets && npm run seed:sql",
    "db:verify": "bash scripts/db-verify.sh"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "13.4.0",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "9.38.0",
    "eslint-config-next": "15.5.25",
    "sharp": "0.34.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
